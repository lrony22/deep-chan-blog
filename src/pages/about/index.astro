---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonaFigure from '../../components/PersonaFigure.astro';
import Reveal from '../../components/Reveal.astro';
import SplitText from '../../components/SplitText.astro';
import Icon from '../../components/Icon.astro';
import copy from '../../data/letterhouse-copy.json';
import { href } from '../../lib/paths.js';

const { about: aboutCopy, home } = copy;
const credits = aboutCopy.colophon.assetCredits;
const tabsLabel = aboutCopy.tabs.map(tab => tab.label).join('、');
---

<BaseLayout title={aboutCopy.titleLead + aboutCopy.titleHighlight} description={aboutCopy.description} active='about'>
  <div class="page-grid">
    <div class="page-stream">
      <header class="page-heading">
        <span class="tiny-label">{aboutCopy.eyebrow}</span>
        <SplitText
          as="h1"
          parts={[{ text: aboutCopy.titleLead }, { text: aboutCopy.titleHighlight, class: 'split-hl' }]}
          mode="word"
          stagger={60}
        />
        <p>{aboutCopy.description}</p>
      </header>

      <section class="welcome welcome--about" aria-labelledby="about-curator">
        <PersonaFigure />
        <div class="welcome-copy">
          <p class="welcome-title" id="about-curator">{aboutCopy.portraitCaption}</p>
          <p class="welcome-desc">
            <span class="persona-silver">{home.silverLabel}</span>
            <span class="persona-ocean">{home.oceanLabel}</span>
          </p>
        </div>
      </section>

      <nav class="about-tabs" aria-label={tabsLabel}>
        {aboutCopy.tabs.map(tab => (
          <a href={'#' + tab.id} aria-current={tab.id === 'profile' ? 'location' : undefined}>{tab.label}</a>
        ))}
      </nav>

      <section class="about-block" id="profile" aria-labelledby="profile-heading" data-reveal="rise">
        <h2 id="profile-heading">{aboutCopy.headline}</h2>
        {aboutCopy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        <div class="about-tags">
          {aboutCopy.tags.map(tag => <span>{tag}</span>)}
        </div>
        <blockquote>{aboutCopy.quote}</blockquote>
        <a class="link-arrow" href={href('posts/')}>
          {aboutCopy.cta}<Icon name="arrow" size={18} />
        </a>
      </section>

      <section class="about-block" id="personas" aria-labelledby="personas-heading">
        <Reveal as="figure" class="about-banner" effect="clip" data-parallax="twin">
          <img
            src={href('images/motion-v2/twin-echo-960.webp')}
            srcset={`${href('images/motion-v2/twin-echo-960.webp')} 960w, ${href('images/motion-v2/twin-echo-1600.webp')} 1600w`}
            sizes="(max-width: 820px) 100vw, 720px"
            width="960"
            height="540"
            alt={aboutCopy.twoShades.bannerAlt}
            loading="lazy"
            decoding="async"
          />
        </Reveal>
        <span class="tiny-label">{aboutCopy.twoShades.badge}</span>
        <h2 id="personas-heading">{aboutCopy.twoShades.title}</h2>
        <p>{aboutCopy.twoShades.silverDesc}</p>
        <p>{aboutCopy.twoShades.easterEggDesc}</p>
      </section>

      <section class="about-block" id="colophon" aria-labelledby="colophon-heading" data-reveal="rise">
        <span class="tiny-label">{aboutCopy.colophon.badge}</span>
        <h2 id="colophon-heading">{aboutCopy.colophon.title}</h2>
        <p>{aboutCopy.colophon.techDesc}</p>
        <p>{aboutCopy.colophon.assetsDesc}</p>
        <p>{credits.mainLabel}：Bilibili UP 主 <a href={credits.mainUrl} rel="noreferrer">{credits.mainAuthor}</a>。</p>
        <p>{credits.hiddenLabel}：{credits.hiddenAuthors}。<a href={credits.licenseUrl} rel="license">{credits.licenseName}</a>（已作 AI 改编）。</p>
        <p>{credits.licenseNote}</p>
        <p class="small-note">{credits.scopeNote}</p>
        <p class="small-note">{aboutCopy.colophon.demoNote}</p>
      </section>
    </div>

    <aside class="page-aside page-aside--single" aria-label={aboutCopy.ledgerTitle}>
      <section class="side-card">
        <h2>{aboutCopy.ledgerTitle}</h2>
        <dl class="about-facts">
          {aboutCopy.facts.map(fact => (
            <div>
              <dt>{fact.term}</dt>
              <dd>{fact.desc}</dd>
            </div>
          ))}
        </dl>
      </section>
    </aside>
  </div>
  <script src='../../scripts/about.js'></script>
</BaseLayout>
